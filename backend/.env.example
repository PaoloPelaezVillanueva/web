# =====================================================================
#  Copia este archivo como ".env" (en esta misma carpeta backend/)
#  y reemplaza los valores. ¡Nunca subas .env a GitHub!
# =====================================================================

# --- Conexión a MySQL ---
# Si instalaste MySQL en tu PC con el puerto por defecto, solo cambia la contraseña.
MYSQL_URL=jdbc:mysql://localhost:3306/ilustroc_universidad?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
MYSQL_USER=root
MYSQL_PASSWORD=TU_PASSWORD_DE_MYSQL

# --- Seguridad: texto largo y aleatorio (mínimo 32 caracteres) ---
JWT_SECRETO=pon-aqui-un-texto-largo-aleatorio-de-al-menos-32-caracteres

# --- Primer administrador (se crea solo si no hay usuarios) ---
ADMIN_USUARIO=admin
ADMIN_PASSWORD=CambiaEstaClave2026

# --- Dirección del frontend (separa varias con comas) ---
CORS_ORIGENES=http://localhost:4200

# --- true = crea equipo, clientes y gestiones de ejemplo si no hay clientes ---
DATOS_DEMO=true

ZONA_HORARIA=America/Lima
